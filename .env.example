GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://tu-dominio-publico.com"
NEXT_PUBLIC_NOTEBOOK_PUBLIC_URL="https://notebooklm.google.com/notebook/tu-notebook-publico"
NEXT_PUBLIC_AUDIO_OVERVIEW_URL="https://tu-dominio.com/audio-overview"
NEXT_PUBLIC_VIDEO_OVERVIEW_URL="https://tu-dominio.com/video-overview"
NEXT_PUBLIC_DOWNLOAD_REPORT_URL="https://tu-dominio.com/dossier-agenda-publica.pdf"
NEXT_PUBLIC_AGENDA_ROUTE_TITLE="La agenda que no nos deja respirar"
NEXT_PUBLIC_AGENDA_ROUTE_DESCRIPTION="Investigación sobre saturación de agenda, fatiga informativa y recambio constante de temas en Argentina y en el mundo, desde 2019 hasta hoy."

# Backend
# Producción: JWT_SECRET y MP_ACCESS_TOKEN son obligatorios; el server no arranca sin ellos.
JWT_SECRET="replace-with-a-long-random-string"
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email (delivery post-checkout) — Resend
# Si falta RESEND_API_KEY en dev, el servicio loguea los mails en consola.
# Producción: creá una API key en https://resend.com y verificá tu dominio.
RESEND_API_KEY=""
FROM_EMAIL="Balosky <hola@balosky.com>"
REPLY_TO_EMAIL="hola@balosky.com"

# Postgres (si aplica) — ver src/server/db.ts
DATABASE_URL="postgres://user:pass@host:5432/balosky"
