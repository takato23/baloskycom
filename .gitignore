# deps / builds
node_modules/
build/
dist/
coverage/

# env
.env*
!.env.example

# data (SQLite local)
data/
backups/

# plataformas / herramientas
.vercel
.claude/
.playwright-mcp/
output/

# macOS
.DS_Store
._*

# logs
*.log

# screenshots y debug artifacts (no subir a git)
/*.png
/*.jpg
/*.jpeg

# scripts one-off
update.py
update_brutalist.py

# reports / notas
informe-balosky.md
README-agenda-publica.md

# user-uploaded media. La idea original era servir estos desde blob
# storage en prod (ver scripts/migrate-media-to-blob.ts), pero hasta
# que esa migración esté lista necesitamos los assets en el repo
# para que Vercel los deployee — es stateless: cada deploy arranca
# desde el commit, no hay disco persistente. Ojo y wallpapers van al
# repo (assets curados). Videos y la carpeta YYYY/MM/ se siguen
# ignorando porque son demasiado pesados o transitorios.
public/uploads/2026/
public/uploads/videos/

# diagnostic / QA build outputs
dist-migrate-check/
dist-preview-check/
dist-test/

# design prototypes (not part of the live app)
design-mockups/

# internal session notes / one-off scripts
AGENTS.md
CODEX_BRIEF.md
__smoke.mjs
HANDOFF_PREVIEW_FULL.md
PLACEHOLDERS.md
preview-full-mockups.html
_commit-productora.sh

# scratch / research / prototypes (no son parte de la app)
tmp/
research/
prototypes/
.playwright-cli/

# backups y dumps locales (pesados, no van a git)
*.zip
*.tar
*.tgz
*.gz

# scan crudo de Luma (~79MB) — solo se usa la versión liviana balosky-luma-scan.ply
public/uploads/3d/*-raw.ply

# planets: los -src.glb son los Meshy originales (~420MB total) que
# NO van a git — los comprimidos planet-0X.glb (el archivo sin -src) sí.
# Borralos a mano desde Finder cuando quieras: Documents/baloskycom/public/models/planets/
public/models/planets/*-src.glb
